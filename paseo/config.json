{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true
    },
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "features": {
    "dictation": {
      "enabled": true
    },
    "voiceMode": {
      "enabled": true
    }
  },
  "agents": {
    "providers": {
      "claude": {
        "additionalModels": [
          {
            "id": "claude-sonnet-4-6",
            "label": "Sonnet 4.6",
            "isDefault": true
          }
        ]
      }
    }
  }
}
