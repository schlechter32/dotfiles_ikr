#!/bin/bash
# Thin shim — delegates to the Python rewrite that properly decodes RFC 2047
# encoded-word subjects (no more =?utf-8?Q?…?= or =?iso-8859-1?Q?…?= leaking
# to the phone). The previous bash version is preserved as
# ~/localapps/bin/mailnotify.bash.bak alongside the symlink.
#
# Defaults to notifying about the newest message in ~/Mail/inbox; override
# with --maildir / --file. Recipient comes from $MAILNOTIFY_TO unless --to
# is passed.
#
# Privacy rules enforced by the Python script:
#   - never includes the source body / Cc / To / attachments
#   - subject is truncated to the first MAILNOTIFY_SUBJECT_CHARS chars
set -e

PY_SCRIPT="${MAILNOTIFY_PY:-$HOME/source/mailtui/scripts/mailnotify.py}"

if [[ ! -f "${PY_SCRIPT}" ]]; then
    echo "mailnotify: ${PY_SCRIPT} not found — set MAILNOTIFY_PY to override" >&2
    exit 1
fi

# Default recipient — Proton.
: "${MAILNOTIFY_TO:=nicolas.hornek@proton.me}"
export MAILNOTIFY_TO

# Default From: identity.
: "${MAILNOTIFY_FROM:=Nicolas Hornek <nicolas.hornek@ikr.uni-stuttgart.de>}"
export MAILNOTIFY_FROM

# Default subject-chars cap. 15 chars is enough to recognise familiar
# senders / threads without leaking sensitive subjects in full.
: "${MAILNOTIFY_SUBJECT_CHARS:=15}"
export MAILNOTIFY_SUBJECT_CHARS

exec python3 "${PY_SCRIPT}" "$@"
