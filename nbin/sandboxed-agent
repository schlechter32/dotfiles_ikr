#!/usr/bin/env bash
set -euo pipefail

# Usage: sandboxed-agent <agent> <worktree-path> [prompt...]
# Examples:
#   sandboxed-agent claude /bulk/.../task-42 "fix the auth bug"
#   sandboxed-agent opencode /bulk/.../task-42 "add tests"
#   sandboxed-agent codex /bulk/.../task-42 "refactor utils"
#   sandboxed-agent zsh /bulk/.../task-42

AGENT="$1"
WORKTREE="$(realpath "$2")"
shift 2
PROMPT="$*"

TASK_ID="$(basename "$WORKTREE")"
TMPDIR="/tmp/agent-${TASK_ID}"
mkdir -p "$TMPDIR"

# Ensure agent config dirs exist
mkdir -p /home/agent/.claude /home/agent/.codex /home/agent/.opencode /home/agent/.cache /home/agent/.local/share/opencode
touch -a /home/agent/.claude.json

# Source API keys
# source /home/agent/.agent-env

BWRAP_ARGS=(
    # --- System (read-only) ---
    --ro-bind /nix/store /nix/store
    --ro-bind /nix/var /nix/var
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/ssl /etc/ssl
    --ro-bind /etc/static /etc/static
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind /etc/passwd /etc/passwd

    --ro-bind /etc/group /etc/group

    --ro-bind /run /run

    # --- Virtual filesystems ---
    --dev /dev
    --proc /proc
    --bind "$TMPDIR" /tmp

    # --- Agent home (read-only base) ---
    --ro-bind /home/agent /home/agent

    # --- Agent auth/config dirs (read-write, overrides ro-bind above) ---
    --bind /home/agent/.claude /home/agent/.claude
    --bind /home/agent/.claude.json /home/agent/.claude.json
    --bind /home/agent/.codex /home/agent/.codex
    --bind /home/agent/.opencode /home/agent/.opencode
    --bind /home/agent/.cache /home/agent/.cache
    --bind /home/agent/.local/share/opencode /home/agent/.local/share/opencode

    # --- Worktree (read-write) — real NFS path so gpu-run works ---
    --bind "$WORKTREE" "$WORKTREE"

    # --- Data directory (read-only) ---
    --ro-bind /bulk/netserv0/data /bulk/netserv0/data

    # --- Environment ---
    --setenv HOME /home/agent
    --setenv TMPDIR /tmp
    --setenv PATH "/home/agent/bin:/home/agent/.npm-global/bin:/home/agent/.local/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/usr/bin:/bin"
    --setenv ANTHROPIC_API_KEY "${ANTHROPIC_API_KEY:-}"
    --setenv OPENAI_API_KEY "${OPENAI_API_KEY:-}"

    # --- Isolation ---
    --unshare-pid
    --die-with-parent
    --unsetenv CLAUDECODE
    --chdir "$WORKTREE"
)

if [[ -e /sys ]]; then
    BWRAP_ARGS+=(--ro-bind /sys /sys)
fi

for gpu_dev in /dev/nvidia0 /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/kfd; do
    if [[ -e "$gpu_dev" ]]; then
        BWRAP_ARGS+=(--dev-bind "$gpu_dev" "$gpu_dev")
    fi
done

if [[ -e /dev/nvidia-caps ]]; then
    BWRAP_ARGS+=(--ro-bind /dev/nvidia-caps /dev/nvidia-caps)
fi

# Build the agent command
case "$AGENT" in
    claude)
        if [[ -n "$PROMPT" ]]; then
            AGENT_CMD=(claude --print --permission-mode bypassPermissions "$PROMPT")
        else
            AGENT_CMD=(claude --permission-mode bypassPermissions)
        fi
        ;;
    opencode)
        if [[ -n "$PROMPT" ]]; then
            AGENT_CMD=(opencode run "$PROMPT")
        else
            AGENT_CMD=(opencode)
        fi
        ;;
    codex)
        if [[ -n "$PROMPT" ]]; then
            AGENT_CMD=(codex exec --full-auto --skip-git-repo-check "$PROMPT")
        else
            AGENT_CMD=(codex)
        fi
        ;;
    zsh)
        AGENT_CMD=(zsh)
        ;;
    *)
        echo "Unknown agent: $AGENT (expected claude, opencode, codex, or zsh)" >&2
        exit 1
        ;;
esac

exec bwrap "${BWRAP_ARGS[@]}" -- "${AGENT_CMD[@]}"
