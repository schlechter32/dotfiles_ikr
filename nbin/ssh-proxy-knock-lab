#!/bin/bash
# ssh-proxy-knock-lab — ProxyCommand helper for netlab gateway (netserv1)
# Knocks the lab firewall then connects via netcat.
# Used in ~/.ssh/config: ProxyCommand ssh-proxy-knock-lab %h %p
set -eu
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(uname)" = "Darwin" ]; then
    "$SCRIPT_DIR/knock_lab_mac" --target "$1" >/dev/null 2>&1 || true
else
    "$SCRIPT_DIR/knock_lab" --target "$1" >/dev/null 2>&1 || true
fi
sleep 0.3
exec nc "$1" "$2"
